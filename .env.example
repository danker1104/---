# 실제 값은 커밋 금지. 각 값을 환경에 맞게 설정하세요.
# 애플리케이션 런타임용 풀링 연결 주소
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yaja_simja?schema=public"
# Prisma 마이그레이션용 직접 연결 주소 (로컬에서는 DATABASE_URL과 동일해도 됨)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yaja_simja?schema=public"
TEACHER_PASSCODE=""
SESSION_SECRET=""
SESSION_HOURS="12"
TZ="Asia/Seoul"
NODE_ENV="development"
